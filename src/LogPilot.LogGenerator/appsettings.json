{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "logpilot",
    "LogRetentionHours": 24,
    "QueryTimeoutSeconds": 5
  },
  "Generator": {
    "NormalTraffic": {
      "Enabled": true,
      "MinIntervalSeconds": 60,
      "MaxIntervalSeconds": 120,
      "MinFlowsPerTick": 1,
      "MaxFlowsPerTick": 3,
      "MaxLogCount": 200000
    },
    "Scheduler": { "TickSeconds": 5, "IntervalMultiplier": 3 },
    "Processor": { "PollIntervalMilliseconds": 1000 }
  }
}
