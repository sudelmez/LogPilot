# docker compose ve scripts/start-local.sh bu dosyayı OKUMAZ; değiştirmek istediğin satırları ".env" adlı yeni bir dosyaya kopyala.
# (.env git'e girmez; API anahtarı da burada durur.)

# Host portları (hepsi yalnızca 127.0.0.1'e açılır). Değiştirmek için başındaki # işaretini kaldır.
# MongoDB portu boşken: 27017 doluysa (ör. brew MongoDB) start.command otomatik 27018 kullanır.
# LOGPILOT_UI_PORT=5173
# LOGPILOT_API_PORT=5080
# LOGPILOT_MONGO_PORT=27017

# Veritabanı adı
LOGPILOT_DB=logpilot

# Boş veritabanında ilk açılışta üretilecek geçmiş log (dakika). 0 = kapalı.
LOGPILOT_BACKFILL_MINUTES=120

# Loglar kaç saat saklansın (sonra MongoDB otomatik siler). Değiştirince yeniden başlatman yeterli.
LOGPILOT_LOG_RETENTION_HOURS=24

# Sürekli normal trafik üretimi (false: sadece tetiklenen/zamanlanmış hata senaryoları log yazar)
LOGPILOT_NORMAL_TRAFFIC=true
# Normal trafik: her X–Y saniyede bir 1–3 kullanıcı akışı
LOGPILOT_TRAFFIC_MIN_SECONDS=60
LOGPILOT_TRAFFIC_MAX_SECONDS=120
# Hata senaryolarının tempo çarpanı: 1 = senaryo dosyasındaki aralık, 3 = üç kat seyrek (varsayılan)
LOGPILOT_INCIDENT_INTERVAL_MULTIPLIER=3

# Yapay zekâ sağlayıcısı:
#   Mock   - kural tabanlı, ücretsiz, anahtar gerekmez (varsayılan)
#   Ollama - bilgisayarda çalışan gerçek model, ücretsiz (önce: brew install ollama && ollama pull qwen3:8b)
#   Claude - Anthropic API, kullandıkça ücretli, en iyi kalite (ANTHROPIC_API_KEY gerekir)
LOGPILOT_AI_PROVIDER=Mock

# Yeni incident'lar için AI özetini otomatik üret. Ollama'da bilgisayarı, Claude'da bakiyeyi meşgul etmesin diye
# false yapabilirsin; özet yine incident ekranındaki "Regenerate" ile istenir.
LOGPILOT_AI_AUTO_SUMMARY=true

# Ollama (yalnızca LOGPILOT_AI_PROVIDER=Ollama iken). Model araç çağırmayı desteklemeli.
LOGPILOT_OLLAMA_MODEL=qwen3:8b
# Docker içinden Mac'teki Ollama'ya: http://host.docker.internal:11434 (start-local.sh localhost kullanır)
LOGPILOT_OLLAMA_URL=http://host.docker.internal:11434

# Claude için API anahtarı (console.anthropic.com → API Keys). Bu dosya git'e girmez; anahtarı başka yere yazma.
ANTHROPIC_API_KEY=

# Model ve düşünme derinliği (low | medium | high | xhigh | max). Derinlik arttıkça cevap yavaşlar ve maliyet artar.
LOGPILOT_AI_MODEL=claude-opus-5-5
LOGPILOT_AI_EFFORT=medium

# Log zaman damgaları UTC'dir; bu yalnızca konteyner saat dilimi.
TZ=Europe/Istanbul

# ---- Güvenli kurulum (docker-compose.secure.yml): MongoDB kimlik doğrulaması + rol ayrımı ----
# Bu satırla tüm docker compose komutları ve start/stop betikleri güvenli modu kullanır.
# İlk geçişte veri klasörü boş olmalı: ./scripts/docker-down.sh --wipe
# COMPOSE_FILE=docker-compose.yml:docker-compose.secure.yml
# LOGPILOT_MONGO_ROOT_PASSWORD=degistir_root
# LOGPILOT_APP_PASSWORD=degistir_app
# LOGPILOT_AI_READER_PASSWORD=degistir_ai
