{
  "id": "normal-invalid-credentials",
  "name": "Normal: invalid credentials",
  "description": "A user mistypes their password (Warning, request-level failure).",
  "kind": "Normal",
  "users": {
    "status": "Active",
    "minCount": 1,
    "maxCount": 1,
    "spacingMs": 0
  },
  "settings": {
    "enabled": true,
    "weight": 3
  },
  "steps": [
    {
      "offsetMs": 0,
      "application": "MobileApp",
      "service": "MobileGateway",
      "level": "Information",
      "operation": "Login",
      "message": "Login request received from {device} (app {appVersion}).",
      "metadata": {
        "device": "{device}",
        "appVersion": "{appVersion}"
      }
    },
    {
      "offsetMs": 70,
      "application": "MobileApp",
      "service": "AuthenticationService",
      "level": "Warning",
      "operation": "Login",
      "message": "Invalid credentials supplied by user {userCode}.",
      "outcome": "Failure",
      "errorCode": "INVALID_CREDENTIALS",
      "durationMs": 70
    }
  ]
}
