{
  "id": "policy-sms-not-sent",
  "name": "Policy SMS: notification event never published",
  "description": "The policy is issued, but PolicyService cannot publish the PolicyIssued event to the notification queue. NotificationGateway never hears about it, so sms_logs has NOTHING for the customer's phone; the cause is in quote_logs.",
  "kind": "Incident",
  "users": {
    "status": "Active",
    "role": "Customer",
    "minCount": 1,
    "maxCount": 1,
    "spacingMs": 0
  },
  "settings": {
    "enabled": true,
    "intervalSeconds": 480,
    "probability": 0.4
  },
  "quote": {
    "channel": "Web",
    "products": [
      "Kasko",
      "Trafik"
    ]
  },
  "steps": [
    {
      "offsetMs": 0,
      "target": "Quote",
      "service": "QuoteOrchestrator",
      "level": "Information",
      "operation": "QuoteRequested",
      "message": "Quote {quoteId} requested via {channel} for {product}.",
      "metadata": {
        "plate": "{plate}"
      }
    },
    {
      "offsetMs": 90,
      "target": "Quote",
      "service": "CustomerRegistryService",
      "level": "Information",
      "operation": "CustomerVerification",
      "message": "Customer identity verified against the customer master (KPS check passed).",
      "durationMs": 80
    },
    {
      "offsetMs": 340,
      "target": "Quote",
      "service": "VehicleRegistryGateway",
      "level": "Information",
      "operation": "VehicleLookup",
      "message": "Vehicle registry (SBM) returned vehicle and damage history for plate {plate}.",
      "durationMs": 230,
      "metadata": {
        "provider": "SBM"
      }
    },
    {
      "offsetMs": 540,
      "target": "Quote",
      "service": "RiskScoringService",
      "level": "Information",
      "operation": "RiskScoring",
      "message": "Risk score calculated: 0.29 (auto-underwriting limit 0.85).",
      "durationMs": 150
    },
    {
      "offsetMs": 1450,
      "target": "Quote",
      "service": "InsurerGateway",
      "level": "Information",
      "operation": "InsurerPricing",
      "message": "Insurer INS_AKS returned a premium offer.",
      "insurerCode": "INS_AKS",
      "premiumAmount": 14800,
      "durationMs": 850
    },
    {
      "offsetMs": 1650,
      "target": "Quote",
      "service": "InsurerGateway",
      "level": "Information",
      "operation": "InsurerPricing",
      "message": "Insurer INS_GNS returned a premium offer.",
      "insurerCode": "INS_GNS",
      "premiumAmount": 14100,
      "durationMs": 1000
    },
    {
      "offsetMs": 1750,
      "target": "Quote",
      "service": "QuoteOrchestrator",
      "level": "Information",
      "operation": "QuoteIssued",
      "message": "Quote {quoteId} issued with 2 offers.",
      "outcome": "Success",
      "durationMs": 1750
    },
    {
      "offsetMs": 60000,
      "target": "Quote",
      "service": "PolicyService",
      "level": "Information",
      "operation": "PolicyIssued",
      "message": "Policy {policyNo} issued from quote {quoteId} (offer INS_GNS).",
      "outcome": "Success",
      "durationMs": 900,
      "metadata": {
        "insurer": "INS_GNS"
      }
    },
    {
      "offsetMs": 60300,
      "target": "Quote",
      "service": "PolicyService",
      "level": "Error",
      "operation": "PolicyNotification",
      "message": "Could not publish PolicyIssued event for policy {policyNo} to the notification queue (broker timeout after 3000 ms).",
      "errorCode": "NOTIFICATION_PUBLISH_FAILED",
      "exceptionType": "BrokerTimeoutException",
      "durationMs": 3000
    }
  ]
}
