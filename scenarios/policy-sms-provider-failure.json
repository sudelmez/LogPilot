{
  "id": "policy-sms-provider-failure",
  "name": "Policy SMS: provider rejects the message",
  "description": "A web quote becomes a policy, but SMS provider PROV_A returns 503 twice; the POLICY_ISSUED SMS is never sent. Root cause is in sms_logs, reachable only by identityNo → phone.",
  "kind": "Incident",
  "users": {
    "status": "Active",
    "role": "Customer",
    "minCount": 1,
    "maxCount": 2,
    "spacingMs": 20000
  },
  "settings": {
    "enabled": true,
    "intervalSeconds": 360,
    "probability": 0.5
  },
  "quote": {
    "channel": "Web",
    "products": [
      "Trafik"
    ]
  },
  "steps": [
    {
      "offsetMs": 0,
      "target": "Quote",
      "service": "QuoteOrchestrator",
      "level": "Information",
      "operation": "QuoteRequested",
      "message": "Quote {quoteId} requested via {channel} for {product}.",
      "metadata": {
        "plate": "{plate}"
      }
    },
    {
      "offsetMs": 90,
      "target": "Quote",
      "service": "CustomerRegistryService",
      "level": "Information",
      "operation": "CustomerVerification",
      "message": "Customer identity verified against the customer master (KPS check passed).",
      "durationMs": 80
    },
    {
      "offsetMs": 340,
      "target": "Quote",
      "service": "VehicleRegistryGateway",
      "level": "Information",
      "operation": "VehicleLookup",
      "message": "Vehicle registry (SBM) returned vehicle and damage history for plate {plate}.",
      "durationMs": 230,
      "metadata": {
        "provider": "SBM"
      }
    },
    {
      "offsetMs": 540,
      "target": "Quote",
      "service": "RiskScoringService",
      "level": "Information",
      "operation": "RiskScoring",
      "message": "Risk score calculated: 0.29 (auto-underwriting limit 0.85).",
      "durationMs": 150
    },
    {
      "offsetMs": 1450,
      "target": "Quote",
      "service": "InsurerGateway",
      "level": "Information",
      "operation": "InsurerPricing",
      "message": "Insurer INS_AKS returned a premium offer.",
      "insurerCode": "INS_AKS",
      "premiumAmount": 14800,
      "durationMs": 850
    },
    {
      "offsetMs": 1650,
      "target": "Quote",
      "service": "InsurerGateway",
      "level": "Information",
      "operation": "InsurerPricing",
      "message": "Insurer INS_GNS returned a premium offer.",
      "insurerCode": "INS_GNS",
      "premiumAmount": 14100,
      "durationMs": 1000
    },
    {
      "offsetMs": 1750,
      "target": "Quote",
      "service": "QuoteOrchestrator",
      "level": "Information",
      "operation": "QuoteIssued",
      "message": "Quote {quoteId} issued with 2 offers.",
      "outcome": "Success",
      "durationMs": 1750
    },
    {
      "offsetMs": 60000,
      "target": "Quote",
      "service": "PolicyService",
      "level": "Information",
      "operation": "PolicyIssued",
      "message": "Policy {policyNo} issued from quote {quoteId} (offer INS_GNS).",
      "outcome": "Success",
      "durationMs": 900,
      "metadata": {
        "insurer": "INS_GNS"
      }
    },
    {
      "offsetMs": 60400,
      "target": "Sms",
      "service": "NotificationGateway",
      "level": "Information",
      "operation": "POLICY_ISSUED",
      "smsStatus": "Queued",
      "message": "POLICY_ISSUED message {messageId} queued for the policyholder.",
      "metadata": {
        "policyEvent": "PolicyIssued"
      }
    },
    {
      "offsetMs": 61400,
      "target": "Sms",
      "service": "SmsProviderAdapter",
      "level": "Error",
      "operation": "POLICY_ISSUED",
      "smsStatus": "Failed",
      "message": "Provider PROV_A rejected message {messageId}: 503 Service Unavailable.",
      "provider": "PROV_A",
      "errorCode": "SMS_PROVIDER_ERROR",
      "durationMs": 1000,
      "metadata": {
        "statusCode": "503",
        "attempt": "1"
      }
    },
    {
      "offsetMs": 91400,
      "target": "Sms",
      "service": "SmsProviderAdapter",
      "level": "Error",
      "operation": "POLICY_ISSUED",
      "smsStatus": "Failed",
      "message": "Retry failed: provider PROV_A rejected message {messageId}: 503 Service Unavailable. Giving up.",
      "provider": "PROV_A",
      "errorCode": "SMS_PROVIDER_ERROR",
      "durationMs": 1000,
      "metadata": {
        "statusCode": "503",
        "attempt": "2"
      }
    }
  ]
}
